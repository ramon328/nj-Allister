# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → Database → Connection string (Session pooler, puerto 5432)
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# URL pública del sitio (sin barra final). MP necesita https para auto_return.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=56978792683

# Mercado Pago (Checkout Pro). Credenciales de producción de la aplicación en
# https://www.mercadopago.cl/developers/panel/app → Credenciales de producción.
MP_ACCESS_TOKEN=APP_USR-...
# Webhooks → Configurar notificaciones → Clave secreta.
MP_WEBHOOK_SECRET=

# Cron de mantenimiento (Vercel manda Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# Correo transaccional (opcional). Sin RESEND_API_KEY no se envían correos.
RESEND_API_KEY=
MAIL_FROM=Allister Eyewear <pedidos@allister-eyewear.com>
MAIL_NOTIFY=contacto@allister-eyewear.com

# Producción pública: 1 = solo muestra "Próximamente" (admin y webhooks siguen activos).
COMING_SOON=
